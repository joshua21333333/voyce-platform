    "taskTypes": [
      "aeo_research",
      "entity_gap_analysis",
      "citation_opportunity_audit"
    ]
  },

  "performanceReporting": {
    "agent": "PERFORMANCE_ANALYST",
    "mode": "standard",
    "sprint": 5,
    "taskTypes": [
      "PERFORMANCE_REPORT",
      "monthly_report",
      "pillar_analysis",
      "format_analysis"
    ]
