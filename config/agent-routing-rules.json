  "evalChecks": {
    "parallel": ["VOICE_MATCH", "AUDIENCE_FIT", "PILLAR_ALIGNMENT"],
    "sequential": ["STANDARDS_CHECK", "BOUNDARIES_CHECK", "EXAMPLES_MATCH", "COHERENCE_CHECK", "PLATFORM_FORMAT"],
    "maxRevisionCycles": 3,
    "escalateAfterCycles": true
  }
